# Maven build output (every module — common-lib, infra/*, services/*)
target/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# No-Docker runtime state, downloaded tools, credentials and release bundles
.runtime/
dist/
infra/no-docker/env.ps1
frontend/.dart_tool/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

