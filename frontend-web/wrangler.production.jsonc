{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doan1-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "doan1-next"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
